{
  "name": "hashgram-io",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Hashgram One product site, live Mainnet explorer and documentation (read-only).",
  "scripts": {
    "dev": "vite",
    "gen:api": "openapi-typescript ../indexer/openapi.yaml -o src/generated/api.d.ts",
    "build:docs": "tsx scripts/build-docs.ts",
    "build:brand": "tsx scripts/build-brand.ts",
    "build:og": "tsx scripts/build-og.ts",
    "prebuild": "pnpm run gen:api && pnpm run build:docs && pnpm run build:brand && pnpm run build:og",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "pnpm run typecheck && stylelint \"src/**/*.css\" && node scripts/check-palette.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@solidjs/router": "^1.0.0",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "lucide-solid": "^1.43.0",
    "minisearch": "^7.2.0",
    "openapi-fetch": "^0.17.0",
    "qrcode": "^1.5.4",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.13.3",
    "@types/opentype.js": "^1.3.10",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "fflate": "^0.8.3",
    "github-slugger": "^2.0.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "opentype.js": "^2.0.0",
    "pngjs": "^7.0.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.4",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.3.4"
}
